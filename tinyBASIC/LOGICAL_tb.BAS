  10 REM LOGICAL AND AND OR OPERATION IN TINY BASIC
  20 REM THE '*' OPERATOR ACTS AS A LOGICAL AND OPERATION
  30 REM THE '+' OPERATOR ACTS AS A LOGICAL  OR OPERATION
  40 RANDOMIZE
  50 FOR I = 1 TO 5
  60 FOR J = 1 TO 5
  70 U = RND(99) : V = RND(99)
  80 IF (U=1)*(V<2)+(U>V)*(U<99)*(V>3) PRINT "TRUE",
  90 PRINT U,V
 100 NEXT J
 110 NEXT I
 200 STOP
 300 END
