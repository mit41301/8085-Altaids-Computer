13EF  CA 1C14           	JZ	TYP3C3
13F2  E6 38             	ANI	38H		; NO, DETERMINE INSTRUCTION
13F4  11 171B           	LXI	D,IOP33		; POINT TO TABLE
13F7  CD DC15           	CALL	POFF		; PRINT INSTRUCTION
